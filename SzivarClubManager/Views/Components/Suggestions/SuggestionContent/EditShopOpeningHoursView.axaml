<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SzivarClubManager.ViewModels.Components.Suggestions.SuggestionContent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SzivarClubManager.Views.Components.Suggestions.SuggestionContent.EditShopOpeningHoursView"
             x:DataType="vm:EditShopOpeningHoursViewModel">
    <Grid
        ColumnDefinitions="*,Auto,*"
        ColumnSpacing="30">
        <ContentControl
            Grid.Column="0"
            Content="{Binding OldScheduleViewModel}" />
        <TextBlock
            Grid.Column="1"
            Text=">>"
            VerticalAlignment="Center"
            FontSize="20" />
        <ContentControl
            Grid.Column="2"
            Content="{Binding NewScheduleViewModel}" />
    </Grid>
</UserControl>