<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SzivarClubManager.ViewModels.Components.Suggestions.SuggestionContent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SzivarClubManager.Views.Components.Suggestions.SuggestionContent.EditShopNameSuggestionView"
             x:DataType="vm:EditShopNameSuggestionViewModel">
    <Grid
        ColumnDefinitions="*,Auto,*"
        ColumnSpacing="30">
        <TextBlock
            Grid.Column="0"
            Text="{Binding EditShopNameSuggestion.Shop.Name}"
            HorizontalAlignment="Right"
            FontSize="17" />
        <TextBlock
            Grid.Column="1"
            Text=">>"
            FontSize="15" />
        <TextBlock
            Grid.Column="2"
            Text="{Binding EditShopNameSuggestion.NewName}"
            FontWeight="Bold"
            HorizontalAlignment="Left"
            FontSize="17" />
    </Grid>
</UserControl>