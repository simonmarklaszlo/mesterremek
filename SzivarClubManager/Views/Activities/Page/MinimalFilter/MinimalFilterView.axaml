<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SzivarClubManager.ViewModels.Activities.Page.MinimalFilter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SzivarClubManager.Views.Activities.Page.MinimalFilter.MinimalFilterView"
             x:DataType="vm:IMinimalFilterViewModel">
    <Grid ColumnDefinitions="Auto, *, Auto">
        <TextBlock
            Grid.Column="0"
            Text="Keresés"
            Margin="40 0"
            FontSize="17"
            TextAlignment="Center"
            VerticalAlignment="Center"
            HorizontalAlignment="Center" />
        <TextBox
            Grid.Column="1"
            Text="{Binding SearchText}"
            Margin="0 15">
            <TextBox.KeyBindings>
                <KeyBinding
                    Gesture="Enter"
                    Command="{Binding TriggerSearchCommand}">
                </KeyBinding>
            </TextBox.KeyBindings>
        </TextBox>
        <Grid
            Grid.Column="2"
            Margin="10 0 10 0"
            ColumnDefinitions="*,*,*">
            <Button
                Grid.Column="0"
                CornerRadius="12"
                Margin="10"
                Padding="10"
                Command="{Binding ClearFilterCommand}">
                <ToolTip.Tip>Szűrő kiürítése</ToolTip.Tip>
                <Image
                    MaxWidth="30"
                    MaxHeight="30">
                    <Image.Styles>
                        <Style Selector="Image">
                            <Setter Property="Source" Value="{DynamicResource ClearIcon}" />
                        </Style>
                        <Style Selector="Button:disabled Image">
                            <Setter Property="Source" Value="{DynamicResource DisabledClearIcon}" />
                        </Style>
                    </Image.Styles>
                </Image>
            </Button>
            <Button
                Grid.Column="1"
                CornerRadius="12"
                Margin="10"
                Padding="10"
                Command="{Binding ShowFilterCommand}">
                <ToolTip.Tip>Szűrő megnyitása</ToolTip.Tip>
                <Image
                    MaxWidth="30"
                    MaxHeight="30"
                    Source="{DynamicResource OpenFilterIcon}" />
            </Button>
            <Button
                Grid.Column="2"
                CornerRadius="12"
                Margin="10"
                Padding="10"
                Command="{Binding TriggerSearchCommand}">
                <ToolTip.Tip>Szűrő kiürításe</ToolTip.Tip>
                <Image
                    MaxWidth="30"
                    MaxHeight="30"
                    Source="{DynamicResource SearchIcon}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>