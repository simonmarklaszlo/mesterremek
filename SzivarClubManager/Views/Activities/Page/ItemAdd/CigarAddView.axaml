<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SzivarClubManager.ViewModels.Activities.Page.ItemAdd"
             xmlns:shared="clr-namespace:SzivarClubManager.Views.Shared"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SzivarClubManager.Views.Activities.Page.ItemAdd.CigarAddView"
             x:DataType="vm:CigarAddViewModel">
    <Grid
        ColumnDefinitions="*,*"
        RowDefinitions="*,Auto">
        <ScrollViewer
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0 40 0 40">
            <StackPanel
                Orientation="Vertical">

                <shared:AddField Label="Name">
                    <TextBox Text="{Binding Name}" />
                </shared:AddField>

                <shared:AddField Label="Brand">
                    <ComboBox
                        ItemsSource="{Binding Brands}"
                        SelectedItem="{Binding Brand}" />
                </shared:AddField>
            </StackPanel>
        </ScrollViewer>

        <shared:BottomActionButton
            Grid.Row="1" Grid.Column="0"
            Text="Mégse"
            Command="{Binding CancelCommand}" />

        <shared:BottomActionButton
            Grid.Row="1" Grid.Column="1"
            Text="Hozzáad"
            Command="{Binding AddCommand}" />
    </Grid>
</UserControl>