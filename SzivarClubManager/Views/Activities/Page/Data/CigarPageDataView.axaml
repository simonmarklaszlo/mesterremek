<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SzivarClubManager.ViewModels.Activities.Page.Data"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SzivarClubManager.Views.Activities.Page.Data.CigarPageDataView"
             x:DataType="vm:CigarPageDataViewModel">

    <Grid RowDefinitions="*,Auto">
        <DataGrid
            Grid.Row="0"
            x:Name="DataGrid"
            ItemsSource="{Binding CurrentPageData}"
            SelectedItem="{Binding SelectedItem}"
            IsReadOnly="True"
            AutoGenerateColumns="True"
            CanUserResizeColumns="True"
            GridLinesVisibility="All">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <ContextMenu
                            DataContext="{Binding $parent[DataGrid].DataContext}"
                            x:DataType="vm:CigarPageDataViewModel">
                            <MenuItem
                                Header="Copy Row"
                                Command="{Binding CopyRowValueCommand}"
                                CommandParameter="{Binding SelectedItem}" />
                            <MenuItem
                                Header="View"
                                Command="{Binding ViewItemCommand}" />
                            <MenuItem
                                Header="Edit"
                                Command="{Binding EditItemCommand}" />
                            <MenuItem
                                Header="Delete"
                                Command="{Binding DeleteItemCommand}" />
                        </ContextMenu>
                    </Setter>
                </Style>
                <Style Selector="DataGridCell:nth-child(1)">
                    <Setter Property="ContextMenu">
                        <ContextMenu
                            DataContext="{Binding $parent[DataGrid].DataContext}"
                            x:DataType="vm:CigarPageDataViewModel">

                            <MenuItem
                                Header="Copy Id"
                                Command="{Binding CopyValueCommand}"
                                CommandParameter="{Binding SelectedItem.Id}" />
                            <MenuItem
                                Header="Copy Row"
                                Command="{Binding CopyRowValueCommand}"
                                CommandParameter="{Binding SelectedItem}" />
                            <MenuItem
                                Header="View"
                                Command="{Binding ViewItemCommand}" />
                            <MenuItem
                                Header="Edit"
                                Command="{Binding EditItemCommand}" />
                            <MenuItem
                                Header="Delete"
                                Command="{Binding DeleteItemCommand}" />
                        </ContextMenu>
                    </Setter>
                </Style>
                <Style Selector="DataGridCell:nth-child(2)">
                    <Setter Property="ContextMenu">
                        <ContextMenu
                            DataContext="{Binding $parent[DataGrid].DataContext}"
                            x:DataType="vm:CigarPageDataViewModel">

                            <MenuItem
                                Header="Copy Name"
                                Command="{Binding CopyValueCommand}"
                                CommandParameter="{Binding SelectedItem.Name}" />
                            <MenuItem
                                Header="Copy Row"
                                Command="{Binding CopyRowValueCommand}"
                                CommandParameter="{Binding SelectedItem}" />
                            <MenuItem
                                Header="View"
                                Command="{Binding ViewItemCommand}" />
                            <MenuItem
                                Header="Edit"
                                Command="{Binding EditItemCommand}" />
                            <MenuItem
                                Header="Delete"
                                Command="{Binding DeleteItemCommand}" />
                        </ContextMenu>
                    </Setter>
                </Style>
                <Style Selector="DataGridCell:nth-child(3)">
                    <Setter Property="ContextMenu">
                        <ContextMenu
                            DataContext="{Binding $parent[DataGrid].DataContext}"
                            x:DataType="vm:CigarPageDataViewModel">

                            <MenuItem
                                Header="Copy Brand"
                                Command="{Binding CopyValueCommand}"
                                CommandParameter="{Binding SelectedItem.Brand}" />
                            <MenuItem
                                Header="Copy Row"
                                Command="{Binding CopyRowValueCommand}"
                                CommandParameter="{Binding SelectedItem}" />
                            <MenuItem
                                Header="View"
                                Command="{Binding ViewItemCommand}" />
                            <MenuItem
                                Header="Edit"
                                Command="{Binding EditItemCommand}" />
                            <MenuItem
                                Header="Delete"
                                Command="{Binding DeleteItemCommand}" />
                        </ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>
        </DataGrid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
            HorizontalAlignment="Center"
            Margin="0 20">

            <Button
                Grid.Column="0"
                IsEnabled="{Binding IsFirstPageButtonEnabled}"
                Command="{Binding LoadFirstPageCommand}"
                Content="&lt;&lt;"
                Margin="10 0" />

            <Button
                Grid.Column="1"
                IsEnabled="{Binding IsPreviousPageButtonEnabled}"
                Command="{Binding LoadPreviousPageCommand}"
                Content="&lt;"
                Margin="10 0" />

            <TextBlock
                Grid.Column="2"
                Text="{Binding CurrentPage}"
                FontWeight="Bold"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="20 0" />

            <Button
                Grid.Column="3"
                IsEnabled="{Binding IsNextPageButtonEnabled}"
                Command="{Binding LoadNextPageCommand}"
                Content="&gt;"
                Margin="10 0" />

            <Button
                Grid.Column="4"
                IsEnabled="{Binding IsLastPageButtonEnabled}"
                Command="{Binding LoadLastPageCommand}"
                Content="&gt;&gt;"
                Margin="10 0" />
        </Grid>
    </Grid>
</UserControl>