<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SzivarClubManager.ViewModels.Activities.FlaggedSuggestions"
             xmlns:behaviors="clr-namespace:SzivarClubManager.Behaviors"
             xmlns:suggestions="clr-namespace:SzivarClubManager.Views.Components.Suggestions"
             xmlns:flaggedSuggestions="clr-namespace:SzivarClubManager.Views.Activities.FlaggedSuggestions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SzivarClubManager.Views.Activities.FlaggedSuggestions.FlaggedSuggestionsActivityView"
             x:DataType="vm:FlaggedSuggestionsActivityViewModel">
    <Grid>
        <ScrollViewer IsVisible="{Binding ShowData}">
            <Interaction.Behaviors>
                <behaviors:InfiniteScrollBehavior LoadMoreCommand="{Binding LoadNextPageCommand}" />
            </Interaction.Behaviors>

            <ItemsControl ItemsSource="{Binding SuggestionsViewModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <suggestions:SuggestionWrapperView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <flaggedSuggestions:FlaggedSuggestionsPlaceholderView IsVisible="{Binding ShowPlaceholder}" />
    </Grid>
</UserControl>